{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "resolveJsonModule": true, "isolatedModules": true,
    "esModuleInterop": true, "skipLibCheck": true, "lib": ["ES2020", "DOM"], "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
