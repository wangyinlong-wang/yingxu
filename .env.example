# Copy to .env locally. Never commit real keys. Restart after editing secrets.
PUBLISHER_TEXT_API_KEY=
PUBLISHER_IMAGE_API_KEY=
PUBLISHER_SPEECH_API_KEY=
# Optional: absolute data directory, otherwise ./data
# PUBLISHER_DATA_DIR=/absolute/path/to/data
# PUBLISHER_TIMEZONE=Asia/Shanghai
PUBLISHER_PORT=8765
# Optional existing ADB executable (only the current app processes use its directory).
# PUBLISHER_ADB_PATH=/absolute/path/to/adb

# 可选：X（TikHub）来源使用；仅在本机填写，每次采集读取一页。
PUBLISHER_TIKHUB_API_KEY=
